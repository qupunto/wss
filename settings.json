{
  "permissions": {
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin +*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git checkout --*)",
      "Bash(git restore*)",
      "Bash(git rebase*)",
      "Bash(git commit --amend*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(gh repo delete*)",
      "Edit(~/.claude/.gitignore)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/wss-doctor.sh)",
      "Edit(~/.claude/hooks/wss-session-check.sh)",
      "Edit(~/.claude/hooks/wss-shorthand-flags.sh)",
      "Edit(~/.claude/hooks/hooks.json)",
      "Edit(~/.claude/.claude-plugin/**)",
      "Edit(.claude/*.sh)",
      "Edit(~/.claude/skills/**)",
      "Edit(~/.claude/agents/**)",
      "Edit(~/.claude/workflow/**)",
      "Edit(.claude/skills/**)",
      "Edit(.claude/agents/**)"
    ],
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "wss-adopt": "user-invocable-only",
    "wss-contracts": "name-only",
    "wss-full-check": "name-only",
    "wss-lane-record-sync": "name-only",
    "wss-retire": "name-only",
    "wss-stocktake": "user-invocable-only",
    "wss-toggle": "user-invocable-only",
    "wss-track": "name-only"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/wss-shorthand-flags.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/wss-session-check.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/wss-alert.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/wss-alert.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/wss-alert.sh"
          }
        ]
      }
    ]
  }
}
