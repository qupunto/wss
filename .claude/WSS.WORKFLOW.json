{
  "WSS": {
    "manifest": "workflow/v2",
    "branch": {
      "integration": "dev",
      "publish": "main"
    },
    "commitTrailer": "Claude-Session",
    "record": {
      "todo": "wss/records/WSS.TODO.md",
      "backlog": "wss/records/WSS.BACKLOG.md",
      "roadmap": "wss/records/WSS.ROADMAP.md",
      "releases": "wss/records/WSS.RELEASES.md",
      "changelog": "wss/logs/WSS.CHANGELOG.md",
      "handoff": "wss/records/WSS.HANDOFF.md",
      "decisions": "wss/logs/WSS.DECISIONS.md",
      "decisionsIndex": "wss/generated/WSS.DECISIONS-INDEX.md",
      "openDecisions": "wss/records/WSS.OPEN-DECISIONS.md",
      "stocktake": "wss/logs/WSS.STOCKTAKE.md",
      "audits": "wss/logs/WSS.AUDITS.md",
      "reference": [
        "README.md"
      ],
      "tooling": {
        "catalog": ".claude/WSS.TOOLING.md",
        "inventory": ".claude/WSS.TOOLS.json",
        "sources": [
          "skills/*/SKILL.md",
          "skills/*/references/*.md",
          "agents/*.md",
          "wss/workflow/*.md",
          "wss/workflow/providers/*.md",
          "wss/workflow/writers/*.md",
          "wss/tests/*.md",
          "commands/*.md"
        ]
      }
    },
    "recordMode": {
      "todo": "register",
      "backlog": "register",
      "roadmap": "register",
      "releases": "register",
      "changelog": "log",
      "handoff": "register",
      "decisions": "log",
      "decisionsIndex": "generated",
      "openDecisions": "register",
      "stocktake": "log",
      "audits": "log",
      "reference": "register",
      "tooling.catalog": "register",
      "tooling.inventory": "generated"
    },
    "commands": {
      "typecheck": "while read -r f; do bash -n \"$f\" || exit 1; done < <(git ls-files --cached --others --exclude-standard '*.sh')",
      "test": "bash wss/tests/wss-hook-contract.sh && bash wss/tests/wss-append-only-test.sh",
      "indexRegen": "bash skills/record/assets/wss-index-decisions.sh",
      "indexCheck": "bash skills/record/assets/wss-index-decisions.sh --check",
      "ci": {
        "tool": "gh",
        "workflow": "Verify"
      }
    },
    "sweeps": ".claude/WSS.SWEEPS.json",
    "agents": {
      "release": "wss-release-prep"
    }
  }
}
